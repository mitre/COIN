{
  "id": "https://example.org/coin/profiles/example-enrollment",
  "version": "1",
  "interaction": "disclosure",
  "capabilities": [
    {
      "id": "enrollment-data",
      "type": "data-access",
      "description": "Retrieve enrollment records for the Preparing Party's selected patient, episode, program, and review date.",
      "scope": "All participation forms, orientation notes, and recorded acceptances of prior orientation for the selected program in the Preparing Party's enrollment file for the requested patient and episode, through reviewDate inclusive in UTC. Return original content from the forms and orientation source groups across the implementing organization's systems, with source identifiers and retrieval completeness.",
      "tools": [
        {
          "name": "get_enrollment_records",
          "description": "Retrieve all records within the enrollment-data scope for the supplied patient, episode, program, and review date. Return the same four scope fields and exactly one result for each source group, forms and orientation. Complete means the full source scope was searched and all matching records returned. Distinguish complete empty results from incomplete, unavailable, and restricted retrieval. Explain the scope and limitations in detail. Preserve each record's identifier, media type, and original content. Return the result as structuredContent and serialized JSON text. No pagination is used.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "patientId": {
                "type": "string",
                "minLength": 1,
                "description": "The Preparing Party's patient identifier."
              },
              "episodeId": {
                "type": "string",
                "minLength": 1,
                "description": "The enrollment episode for this patient."
              },
              "program": {
                "type": "string",
                "minLength": 1,
                "description": "The program identifier agreed by the participants. Retrieve records only for this program."
              },
              "reviewDate": {
                "type": "string",
                "format": "date",
                "description": "Include the episode's records through this UTC calendar date."
              }
            },
            "required": [
              "patientId",
              "episodeId",
              "program",
              "reviewDate"
            ],
            "additionalProperties": false
          },
          "outputSchema": {
            "type": "object",
            "properties": {
              "patientId": {
                "type": "string",
                "minLength": 1
              },
              "episodeId": {
                "type": "string",
                "minLength": 1
              },
              "program": {
                "type": "string",
                "minLength": 1,
                "description": "The requested program identifier."
              },
              "reviewDate": {
                "type": "string",
                "format": "date"
              },
              "sources": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "enum": [
                        "forms",
                        "orientation"
                      ]
                    },
                    "status": {
                      "enum": [
                        "complete",
                        "incomplete",
                        "unavailable",
                        "restricted"
                      ]
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    },
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uri"
                          },
                          "format": {
                            "enum": [
                              "application/json",
                              "text/plain"
                            ]
                          },
                          "content": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "status": {
                                    "enum": [
                                      "signed",
                                      "unsigned",
                                      "unknown"
                                    ]
                                  },
                                  "signedOn": {
                                    "type": "string",
                                    "format": "date"
                                  }
                                },
                                "required": [
                                  "status"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "string",
                                "minLength": 1
                              }
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "format",
                          "content"
                        ],
                        "additionalProperties": false,
                        "allOf": [
                          {
                            "if": {
                              "properties": {
                                "format": {
                                  "const": "application/json"
                                }
                              }
                            },
                            "then": {
                              "properties": {
                                "content": {
                                  "type": "object"
                                }
                              }
                            },
                            "else": {
                              "properties": {
                                "content": {
                                  "type": "string"
                                }
                              }
                            }
                          }
                        ]
                      }
                    }
                  },
                  "required": [
                    "name",
                    "status",
                    "detail",
                    "records"
                  ],
                  "additionalProperties": false,
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "name": {
                            "const": "forms"
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "records": {
                            "items": {
                              "properties": {
                                "format": {
                                  "const": "application/json"
                                }
                              }
                            }
                          }
                        }
                      },
                      "else": {
                        "properties": {
                          "records": {
                            "items": {
                              "properties": {
                                "format": {
                                  "const": "text/plain"
                                }
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "enum": [
                              "unavailable",
                              "restricted"
                            ]
                          }
                        }
                      },
                      "then": {
                        "properties": {
                          "records": {
                            "maxItems": 0
                          }
                        }
                      }
                    }
                  ]
                }
              }
            },
            "required": [
              "patientId",
              "episodeId",
              "program",
              "reviewDate",
              "sources"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ]
}
